# --- required (server refuses to start without these) ---
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/milestone
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# Public URL of the live site (canonicals, OG tags, sitemap). Example: https://milestonerealstate.pk
SITE_URL=

# --- Cloudinary (required for photo upload, Phase 2) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google reviews (optional; reviews section hides itself if missing) ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- email notification on new inquiries (optional) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
